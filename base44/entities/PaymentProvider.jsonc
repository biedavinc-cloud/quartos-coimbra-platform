{
  "name": "PaymentProvider",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "tagline": { "type": "string" },
    "coverage": { "type": "string", "description": "Codes pays ISO séparés par des virgules" },
    "currencies": { "type": "string" },
    "methods": { "type": "string" },
    "docs_url": { "type": "string" },
    "dashboard_url": { "type": "string" },
    "settlement": { "type": "string" },
    "auth_model": {
      "type": "string",
      "enum": ["basic_api_key", "secret_key", "api_key_site", "oauth_client"],
      "enumColors": ["blue", "green", "purple", "yellow"],
      "description": "Schéma d'authentification réel du PSP"
    },
    "credential_keys": {
      "type": "string",
      "description": "Noms des secrets à créer dans Secrets (jamais les valeurs)"
    },
    "base_url_test": { "type": "string" },
    "base_url_live": { "type": "string" },
    "checkout_path": { "type": "string" },
    "webhook_path": { "type": "string" },
    "signature_header": { "type": "string" },
    "fees_percent": { "type": "number" },
    "min_amount": { "type": "number" },
    "refund_support": { "type": "boolean", "default": false },
    "enabled": { "type": "boolean", "default": false },
    "mode": {
      "type": "string",
      "enum": ["test", "live"],
      "enumColors": ["yellow", "green"],
      "default": "test"
    },
    "merchant_id": { "type": "string", "description": "Identifiant public uniquement (site_id, shortcode…)" },
    "notes": { "type": "string" },
    "sort_order": { "type": "number" }
  },
  "required": ["name", "slug"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
